<ResourceDictionary
    x:Class="AIWeather.SequenceItems.SequenceItemTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AIWeather.SequenceItems"
    xmlns:mini="clr-namespace:NINA.View.Sequencer.MiniSequencer;assembly=NINA.Sequencer"
    xmlns:nina="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer">

    <!-- Start Monitoring Icon: cloud with play arrow -->
    <GeometryGroup x:Key="AIWeather_StartIcon" FillRule="EvenOdd">
        <!-- Cloud shape -->
        <PathGeometry Figures="M6,14 A4,4 0 0,1 6,6 A6,6 0 0,1 18,6 A4,4 0 0,1 18,14 Z"/>
        <!-- Play triangle -->
        <PathGeometry Figures="M9,17 L9,23 L15,20 Z"/>
    </GeometryGroup>

    <!-- Stop Monitoring Icon: cloud with stop square -->
    <GeometryGroup x:Key="AIWeather_StopIcon" FillRule="EvenOdd">
        <!-- Cloud shape -->
        <PathGeometry Figures="M6,14 A4,4 0 0,1 6,6 A6,6 0 0,1 18,6 A4,4 0 0,1 18,14 Z"/>
        <!-- Stop square -->
        <RectangleGeometry Rect="9,17,6,6"/>
    </GeometryGroup>

    <!-- Start Monitoring Instruction -->
    <DataTemplate DataType="{x:Type local:StartMonitoringInstruction}">
        <nina:SequenceBlockView />
    </DataTemplate>

    <DataTemplate x:Key="AIWeather.SequenceItems.StartMonitoringInstruction_Mini">
        <mini:MiniSequenceItem>
            <mini:MiniSequenceItem.SequenceItemContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="AI Weather Start" />
                </StackPanel>
            </mini:MiniSequenceItem.SequenceItemContent>
        </mini:MiniSequenceItem>
    </DataTemplate>

    <!-- Stop Monitoring Instruction -->
    <DataTemplate DataType="{x:Type local:StopMonitoringInstruction}">
        <nina:SequenceBlockView />
    </DataTemplate>

    <DataTemplate x:Key="AIWeather.SequenceItems.StopMonitoringInstruction_Mini">
        <mini:MiniSequenceItem>
            <mini:MiniSequenceItem.SequenceItemContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="AI Weather Stop" />
                </StackPanel>
            </mini:MiniSequenceItem.SequenceItemContent>
        </mini:MiniSequenceItem>
    </DataTemplate>

</ResourceDictionary>
